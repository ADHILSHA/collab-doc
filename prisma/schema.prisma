// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(cuid())
  name     String
  colorHex String

  ownedDocuments Document[]         @relation("OwnedDocuments")
  sharedWithMe   DocumentShare[]
  presences      DocumentPresence[]
  comments       Comment[]

  createdAt DateTime @default(now())
}

model Document {
  id             String   @id @default(cuid())
  title          String
  content        Json     @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  sourceFileName String?

  owner   User   @relation("OwnedDocuments", fields: [ownerId], references: [id])
  ownerId String

  shares    DocumentShare[]
  presences DocumentPresence[]
  comments  Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentShare {
  id String @id @default(cuid())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())

  @@unique([documentId, userId])
}

model DocumentPresence {
  id String @id @default(cuid())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lastSeenAt DateTime @updatedAt

  @@unique([documentId, userId])
}

model Comment {
  id String @id @default(cuid())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  body       String
  quotedText String
  resolved   Boolean @default(false)

  createdAt DateTime @default(now())
}
